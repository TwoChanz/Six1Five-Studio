# ===================================
# DATABASE CONFIGURATION
# ===================================

# For local development, use SQLite by setting USE_SQLITE=true
# For production, set USE_SQLITE=false and configure DATABASE_URL
USE_SQLITE=true

# PostgreSQL connection string (required in production)
# Format: postgresql://username:password@host:port/database
# Examples:
#   - Railway: postgresql://postgres:xxxxx@containers-us-west-x.railway.app:5432/railway
#   - Neon: postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/neondb
#   - Supabase: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres:password@localhost:5432/six1five_portfolio

# ===================================
# SECURITY
# ===================================

# JWT Secret for Admin Authentication (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This should be a random 64-character hexadecimal string
JWT_SECRET=your_generated_jwt_secret_here

# Admin Password (Development)
# For local development, use plain text password
# ADMIN_PASSWORD=admin615

# Admin Password Hash (Production)
# For production, use bcrypt hash for better security
# Generate with: npx tsx scripts/hash-password.ts YOUR_PASSWORD
# ADMIN_PASSWORD_HASH=$2a$10$your_bcrypt_hash_here

# ===================================
# EMAIL NOTIFICATIONS (Optional but recommended)
# ===================================

# SendGrid API Key - Get yours at: https://sendgrid.com
# Without this, contact form submissions will only save to database (no email alerts)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender email address (must be verified in SendGrid)
# SENDGRID_FROM_EMAIL=admin@six1fivestudio.com

# Recipient email for contact form notifications (defaults to FROM_EMAIL if not set)
# SENDGRID_TO_EMAIL=admin@six1fivestudio.com

# ===================================
# ANALYTICS (Optional but recommended)
# ===================================

# Google Analytics 4 Measurement ID - Get yours at: https://analytics.google.com
# Format: G-XXXXXXXXXX
# Without this, no visitor analytics will be tracked
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===================================
# DEPLOYMENT
# ===================================

# Environment (set automatically by hosting platform)
# NODE_ENV=production
