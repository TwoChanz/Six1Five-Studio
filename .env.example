# Database Configuration
# For local development, use SQLite by setting USE_SQLITE=true
# For production, use PostgreSQL with DATABASE_URL
USE_SQLITE=true
# DATABASE_URL=postgresql://postgres:password@localhost:5432/six1five_portfolio

# Email Notifications (Optional - contact form will save to DB without these)
# Get your SendGrid API key at: https://sendgrid.com
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=admin@six1fivestudio.com
# SENDGRID_TO_EMAIL=admin@six1fivestudio.com

# Google Analytics (Optional but recommended)
# Get your GA4 Measurement ID at: https://analytics.google.com
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
